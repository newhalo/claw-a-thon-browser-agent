# Public gateway port
PORT=8080

# Internal native server endpoint (the wrapped mcp-b native host)
NATIVE_SERVER_INTERNAL_HOST=127.0.0.1
NATIVE_SERVER_INTERNAL_PORT=12306
NATIVE_SERVER_HEALTH_PATH=/health
NATIVE_SERVER_STARTUP_TIMEOUT_MS=30000

# Optional override for start command of mcp-b native host.
# Leave empty to use bundled @mcp-b/native-server entrypoint.
# NATIVE_SERVER_BIN=node
# NATIVE_SERVER_ARGS=./node_modules/@mcp-b/native-server/dist/index.js
NATIVE_SERVER_ARGS=

# Security (recommended for cloud/public deployment)
# Option A: single token
AUTH_TOKEN=replace-me-with-a-strong-token
# Option B: multiple tokens separated by comma
# AUTH_TOKENS=token-a,token-b

# For local debug only; do not use in public environments
ALLOW_NO_AUTH=false

# Optional for custom/dev extension builds (WebMCP compatible)
# DEV_EXTENSION_ID=your-dev-extension-id-from-chrome-extensions

# Backward-compatible alias (if set, gateway maps it to DEV_EXTENSION_ID)
# EXTENSION_ID=your-dev-extension-id
