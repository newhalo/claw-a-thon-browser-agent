# ── LLM Provider ──────────────────────────────────────────
# Options: anthropic | openai | vngcloud | openai-compat
PROVIDER=vngcloud

# Anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_DEFAULT_MODEL=gpt-4o

# VNGCloud (MaaS)
VNGCLOUD_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
VNGCLOUD_API_KEY=replace-me
VNGCLOUD_DEFAULT_MODEL=qwen/qwen3-5-27b

# OpenAI-compatible (OpenRouter, LiteLLM, VNGCloud, etc.)
# PROVIDER=openai-compat
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_DEFAULT_MODEL=
# Set to true if the provider supports function calling / tools
CUSTOM_TOOLS_SUPPORTED=false
# Set to true if the provider supports vision (image input)
CUSTOM_VISION_SUPPORTED=false

# VNGCloud example:
# CUSTOM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
# CUSTOM_API_KEY=replace-me
# CUSTOM_DEFAULT_MODEL=qwen/qwen3-5-27b

# ── MCP / native-server ────────────────────────────────────
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_AUTH_TOKEN=replace-me-with-native-server-token

# ── Service ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# Multiple tokens comma-separated (recommended)
AUTH_TOKENS=replace-me-with-a-strong-token
# Single token (legacy, backward-compatible with AUTH_TOKENS)
# AGENT_TOKEN=replace-me
# Comma-separated allowed CORS origins (chrome-extension:// matches all extension IDs)
CORS_ORIGINS=chrome-extension://,http://localhost
